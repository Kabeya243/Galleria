generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  // Null for accounts created with Google sign-in (no password set).
  passwordHash String?
  // Google account id for accounts created or linked with Google sign-in.
  googleId     String?      @unique
  // Chosen at signup: what the account does on SANAA (artist, curator,
  // gallery, collector, advisor, institution…) and where they are based.
  // Optional so accounts created before this field existed keep working.
  role         String?
  country      String?
  createdAt    DateTime     @default(now())
  exhibitions  Exhibition[]
  resetTokens  PasswordResetToken[]
  savedWorks   SavedWork[]
  listings     Listing[]
  teamsOwned   Team[]
  teamMemberships TeamMember[]
  teamComments TeamComment[]
  teamActivities TeamActivity[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exhibition {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @default("")
  status      String     @default("draft")
  // Who can open a published exhibition: "public" (listed, open to
  // everyone), "private-link" (published but never listed — only the
  // direct URL opens it) or "password" (published, but a password is
  // asked before entering). Drafts ignore this field.
  visibility         String  @default("public")
  accessPasswordHash String?
  roomColor   String     @default("#f5f2eb")
  rooms       String     @default("[{\"id\":\"room-main\",\"name\":\"Room 1\",\"layout\":\"cube\",\"wallColor\":\"#f5f2eb\",\"sideWallColor\":\"#e2ded6\",\"floorColor\":\"#3f3d3a\",\"ceilingColor\":\"#f5f2eb\",\"wallTexture\":\"plaster\",\"floorTexture\":\"stone\",\"ceilingTexture\":\"plaster\",\"spotlights\":true,\"partitionWalls\":[],\"curatorialText\":\"\"}]")
  views       Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artworks    Artwork[]

  @@index([ownerId])
  @@index([status, slug])
}

model Artwork {
  id           String     @id @default(cuid())
  title        String
  artist       String     @default("")
  year         String     @default("")
  medium       String     @default("")
  dimensions   String     @default("")
  description  String     @default("")
  color        String     @default("#b8a184")
  accent       String     @default("#343e36")
  positionX    Float      @default(0)
  positionY    Float      @default(2.5)
  positionZ    Float      @default(-5.72)
  rotation     Float      @default(0)
  scale        Float      @default(1)
  frame        String     @default("wood")
  imageUrl     String?
  // Curatorial wall text (the reference room's "Texte curatorial"):
  // when set, the artwork renders as a canvas text panel instead of an
  // image, in the chosen typeface. Null for ordinary artworks.
  text         String?
  textFont     String?
  // Colour palette extracted from the artwork image (ColorThief, in the
  // browser, at upload/replace time): a JSON array of up to 8 hex
  // colours, dominant first, e.g. ["#1A1A1A","#C8321E","#F0E6D2"].
  // Stored as a JSON string (like rooms) so it works on SQLite and
  // Postgres alike. Null until extracted.
  palette      String?
  roomId       String     @default("room-main")
  createdAt    DateTime   @default(now())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

// Uploaded artwork images, stored in the database (not on disk): Vercel's
// runtime filesystem is read-only and does not persist between requests,
// so files written to data/uploads never survived an upload there.
model Upload {
  id        String   @id
  data      Bytes
  mimeType  String   @default("image/webp")
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// One row per tool page load: which tool was opened, by whom, and when.
// No input values, form contents or calculator numbers are ever stored
// here — only the tool slug, the user id (null when not signed in) and the
// time. The table starts empty and grows from the day tracking ships.
// One row per public exhibition view (and per artwork-detail open).
// Exhibition.views stays as the blunt all-time counter; this table is
// the history behind it: per-day counts, unique visitors (via an
// anonymous random visitorKey cookie — no personal data, no IP stored),
// and, where the browser/platform supplies them, country (from the
// x-vercel-ip-country header only), device class (from the user-agent)
// and referrer. Anything absent is stored as null, never invented.
model VisitLog {
  id           String   @id @default(cuid())
  exhibitionId String
  artworkId    String?
  // The UTC-midnight date of the visit, so daily buckets are a plain
  // group-by on this column.
  day          DateTime
  visitorKey   String
  country      String?
  device       String?
  referrer     String?
  // Seconds the visitor spent in the exhibition, sent by the client
  // when the visit ends (pagehide). Null when the browser never
  // reported a duration — never invented.
  durationSeconds Int?
  createdAt    DateTime @default(now())

  @@index([exhibitionId, day])
  @@index([artworkId, day])
}

model ToolUse {
  id        String   @id @default(cuid())
  tool      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([tool])
  @@index([createdAt])
}

// Marketplace listings (Phase 6). A listing is public-facing: anyone can
// browse active listings; only the seller can edit or withdraw theirs.
// Payments are NOT handled here — checkout is a labelled Stripe
// integration point, not a real charge. See the Marketplace tool.
model Listing {
  id            String    @id @default(cuid())
  sellerId      String
  seller        User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  artworkId     String?
  title         String
  artist        String    @default("")
  year          String    @default("")
  medium        String    @default("")
  dimensions    String    @default("")
  description   String    @default("")
  imageUrl      String?
  price         Int?
  currency      String    @default("USD")
  kind          String    @default("original")
  editionSize   Int?
  editionNumber Int?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  inquiries     Inquiry[]

  @@index([sellerId])
  @@index([status])
}

// Purchase inquiries on a listing (Phase 6). Buyer contact details are
// stored only so the seller can reply; nothing is shared elsewhere.
model Inquiry {
  id         String   @id @default(cuid())
  // Marketplace inquiry: the listing being asked about. Null for a
  // "contact the artist" message sent from an artwork in an exhibition.
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Artist-contact inquiry: the artwork and exhibition it came from.
  artworkId    String?
  exhibitionId String?
  buyerId    String?
  buyerName  String   @default("")
  buyerEmail String   @default("")
  message    String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([exhibitionId])
  @@index([artworkId])
}

// Team collaboration (Phase 6). A team owns shared exhibition access
// (ProjectShare), comments and an activity log. Permissions are enforced
// server-side in the teams API routes, never only in the UI.
model Team {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   TeamMember[]
  shares    ProjectShare[]
  comments  TeamComment[]
  activity  TeamActivity[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model ProjectShare {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  exhibitionId String
  permission   String   @default("view")
  createdAt    DateTime @default(now())

  @@unique([teamId, exhibitionId])
  @@index([exhibitionId])
}

model TeamComment {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  exhibitionId String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  status       String   @default("open")
  createdAt    DateTime @default(now())

  @@index([teamId])
  @@index([exhibitionId])
}

model TeamActivity {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  target    String   @default("")
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// User-saved work from the Creative Studio tools (Mockup Studio, Color
// Intelligence, Photography Lab, Presentation Designer, Certificate
// Studio, Frame Studio presets). One table, `kind` distinguishes the
// tool; `data` holds the tool-specific configuration as JSON so each tool
// can evolve without a schema migration. Always user-scoped: tools only
// ever read or write the signed-in user's own rows.
model SavedWork {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String   @default("")
  data      String   @default("{}")
  artworkId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, updatedAt])
}

// Room templates hidden by the owner from the admin panel. Templates
// live in code (lib/rooms.ts); hiding one only records its layout id
// here, so the removal survives reloads and redeploys. Hidden templates
// are filtered out wherever templates are listed, but exhibitions
// already built with one keep working — they fall back to the White
// Cube only if the layout itself disappears from the code.
model HiddenRoomTemplate {
  id        String   @id @default(cuid())
  layout    String   @unique
  createdAt DateTime @default(now())
}
