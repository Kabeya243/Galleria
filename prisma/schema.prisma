generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  // Null for accounts created with Google sign-in (no password set).
  passwordHash String?
  // Google account id for accounts created or linked with Google sign-in.
  googleId     String?      @unique
  // Chosen at signup: what the account does on SANAA (artist, curator,
  // gallery, collector, advisor, institution…) and where they are based.
  // Optional so accounts created before this field existed keep working.
  role         String?
  country      String?
  createdAt    DateTime     @default(now())
  exhibitions  Exhibition[]
  posts        Post[]
  likes        Like[]
  // Email verification (Nov 2026): set when the visitor confirms the
  // link sent to their inbox at signup. Null for accounts created
  // before verification shipped — see isEmailVerified in
  // lib/email-verification.ts (legacy accounts keep working).
  emailVerifiedAt DateTime?
  resetTokens  PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  // Private messaging (Nov 2026): conversations as participant A or B,
  // and messages sent. See Conversation / Message below.
  conversationsAsA Conversation[] @relation("ConversationAsA")
  conversationsAsB Conversation[] @relation("ConversationAsB")
  messagesSent    Message[]
  // Messaging safety (Nov 2026): blocks given and received, and
  // reports filed. See UserBlock / MessageReport below.
  blocksGiven    UserBlock[]     @relation("UserBlockBlocker")
  blocksReceived UserBlock[]     @relation("UserBlockBlocked")
  messageReports MessageReport[] @relation("MessageReportReporter")
  savedWorks   SavedWork[]
  listings     Listing[]
  libraryWorks LibraryWork[]
  contacts     Contact[]
  teamsOwned   Team[]
  teamMemberships TeamMember[]
  teamComments TeamComment[]
  teamActivities TeamActivity[]
  // Sub-admin grants (Nov 2026): the manager (platform owner) can give
  // another account limited access to the admin dashboard. The grant
  // itself is the SubAdmin row below; grantedSubAdmins are the grants
  // this user handed out. See lib/admin.ts for the permission list.
  subAdminGrant    SubAdmin?  @relation("SubAdminUser")
  grantedSubAdmins SubAdmin[] @relation("SubAdminGrantor")
  // Advanced website builder (Claude editor): sites created in
  // /tools/website-builder/advanced. See models Site/Page/Section/
  // Block/Template/Media below.
  sites         Site[]
  // Open calls (Nov 2026): calls for applications the user creates
  // in /tools/open-calls. See OpenCall below.
  openCalls     OpenCall[]
  // Subscription (Nov 2026): one row per account, the plan the account
  // is on. Every account starts on Discovery (free); the row is created
  // lazily on first read by lib/subscriptions.ts. See SubscriptionPlan
  // and Subscription below.
  subscription Subscription?
  // Terms acceptance (Nov 2026): set at signup (mandatory there) and
  // again at every plan change, when the visitor ticks "I accept the
  // Terms of Use and the Privacy Policy". Null for accounts created
  // before this field existed.
  termsAcceptedAt DateTime?
  // Referral (Nov 2026): a unique code for this account (letters from
  // the name plus random characters, uppercase), shown on the "My plan"
  // card with a shareable link. referredById is the account whose code
  // this account used at signup, if any. See Referral below.
  referralCode String? @unique
  referredById String?
  // Promo codes created by this account (manager or sub-admin with
  // subscriptions.manage) and promo code uses by this account.
  promoCodesCreated PromoCode[] @relation("PromoCodeCreator")
  promoCodeUses PromoCodeUse[]
  // Referrals: given (this account invited others) and received (this
  // account was invited by someone).
  referralsGiven   Referral[] @relation("ReferralReferrer")
  referralReceived Referral?  @relation("ReferralReferred")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email verification token (Nov 2026): same shape as
// PasswordResetToken — the raw token is emailed once and only its
// SHA-256 hash is stored, it expires after 24 h, and it is single-use
// (usedAt is set when the link is confirmed). A new token is issued on
// signup and on every resend; issuing deletes the previous unused
// tokens for the user, so only the latest link works. Applied by
// `prisma db push` on deploy (see vercel.json); no data migration —
// existing users keep emailVerifiedAt null and are grandfathered by
// lib/email-verification.ts.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Private messaging (Nov 2026): one conversation per pair of users
// plus an optional context (an exhibition or an artwork the message is
// about, i.e. an inquiry). The two participants are stored in id order
// so the pair is unique, and the context makes asking about two
// different works open two threads. Messages are private: only the two
// participants can read them. Applied by `prisma db push` on deploy
// (see vercel.json); no data migration — the tables start empty.
model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ConversationAsA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ConversationAsB", fields: [participantBId], references: [id], onDelete: Cascade)
  exhibitionId   String?
  exhibition     Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)
  artworkId      String?
  artwork        Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
  reports        MessageReport[]

  @@index([participantAId])
  @@index([participantBId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  reports MessageReport[]

  @@index([conversationId, createdAt])
}

// Messaging safety (Nov 2026): blocking and reporting. A block is one
// row per (blocker, blocked); the blocked user can no longer send new
// messages to the blocker (checked server-side in POST /api/messages
// and POST /api/messages/[id], 403) and the conversation disappears
// from the blocker's inbox. A report records who reported which
// message and/or conversation and why; admins read them at
// GET /api/admin/reports. Applied by `prisma db push` on deploy (see
// vercel.json); no data migration — the tables start empty.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model MessageReport {
  id             String        @id @default(cuid())
  reporterId     String
  reporter       User          @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([reporterId])
}

// Contacts (Nov 2026): the artist's own address book — collectors,
// curators, galleries, advisors — stored on the account, not in the
// browser. Previously localStorage only ("Saved in this browser only");
// the tool migrates any browser copy into the database on first load.
model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String   @default("Collector")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Exhibition {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @default("")
  status      String     @default("draft")
  // Who can open a published exhibition: "public" (listed, open to
  // everyone), "private-link" (published but never listed — only the
  // direct URL opens it) or "password" (published, but a password is
  // asked before entering). Drafts ignore this field.
  visibility         String  @default("public")
  accessPasswordHash String?
  // Background music for the whole visit (option A, one track per
  // exhibition): the same-origin serving URL (/api/audio/audio/…),
  // the title visitors see, loop on by default, and the artist's
  // starting volume (0..1). Null audioUrl = no music. Removing the
  // track here does NOT delete the file in R2 (no DeleteObject in
  // the code yet) — orphaned audio files are a known cleanup debt.
  audioUrl     String?
  audioTitle   String?
  audioLoop    Boolean  @default(true)
  audioVolume  Float    @default(0.5)
  roomColor   String     @default("#f5f2eb")
  rooms       String     @default("[{\"id\":\"room-main\",\"name\":\"Room 1\",\"layout\":\"cube\",\"wallColor\":\"#f5f2eb\",\"sideWallColor\":\"#e2ded6\",\"floorColor\":\"#3f3d3a\",\"ceilingColor\":\"#f5f2eb\",\"wallTexture\":\"plaster\",\"floorTexture\":\"stone\",\"ceilingTexture\":\"plaster\",\"spotlights\":true,\"partitionWalls\":[],\"curatorialText\":\"\"}]")
  // Guided tour (Nov 2026): one narrative walk per exhibition, stored
  // as a JSON string (like rooms) — see lib/tour.ts for the shape and
  // for why there is no separate Tour/Stop model. Null = no tour yet.
  // Applied by `prisma db push` on deploy (see vercel.json); no data
  // migration — existing rows keep tour null and behave as before.
  tour        String?
  views       Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artworks    Artwork[]
  posts       Post[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([status, slug])
}

// Publication feed (Nov 2026, chantier 2/5): one Post per published
// exhibition, with likes. These tables are ALSO read/written by the
// FastAPI social feed (api/models.py, api/social.py) — the Prisma
// model, column names and constraints below must stay identical to
// those SQLAlchemy models. Prisma is the single source of truth for
// the schema: the raw SQL migration that used to live in
// api/migrations/001_social_feed.sql was deleted, `prisma db push`
// creates these tables on deploy. One deliberate difference from
// that SQL: its feed index was a partial index
// (createdAt DESC, id DESC WHERE isVisible = TRUE), which Prisma
// cannot express — the plain @@index([createdAt]) below covers the
// feed ordering (api/social.py also filters isVisible itself).
model Post {
  id            String     @id @default(cuid())
  exhibitionId  String     @unique
  exhibition    Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  coverImageUrl String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isVisible     Boolean    @default(true)
  likes         Like[]

  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Artwork {
  id           String     @id @default(cuid())
  title        String
  artist       String     @default("")
  year         String     @default("")
  medium       String     @default("")
  dimensions   String     @default("")
  description  String     @default("")
  color        String     @default("#b8a184")
  accent       String     @default("#343e36")
  positionX    Float      @default(0)
  positionY    Float      @default(2.5)
  positionZ    Float      @default(-5.72)
  rotation     Float      @default(0)
  scale        Float      @default(1)
  frame        String     @default("wood")
  imageUrl     String?
  // Video artwork (Nov 2026): when set, this artwork is a video, not
  // an image — the wall renders a VideoTexture from this same-origin
  // serving URL (/api/video/videos/<userId>/<uuid>.mp4, MP4 H.264,
  // 4.5 MB cap, same R2 proxy pattern as images and music). `imageUrl`,
  // when also set, is only the fallback poster. Null for ordinary
  // image artworks, text panels and placeholders. Applied by
  // `prisma db push` on deploy (see vercel.json); no data migration —
  // existing rows keep videoUrl null and render unchanged.
  videoUrl     String?
  // Sculpture artwork (Nov 2026): when set, this artwork is a 3D
  // sculpture, not an image or a video — the room renders the GLB
  // from this same-origin serving URL
  // (/api/sculpture/sculptures/<userId>/<uuid>.glb, GLB only, 4.5 MB
  // cap, same R2 proxy pattern as images, music and video) on an
  // automatic white pedestal (~1 m high) standing on the floor.
  // `imageUrl`, when also set, is only a poster for list views.
  // Null for ordinary image/video artworks. Applied by
  // `prisma db push` on deploy (see vercel.json); no data migration —
  // existing rows keep sculptureUrl null and render unchanged.
  sculptureUrl String?
  // Curatorial wall text (the reference room's "Texte curatorial"):
  // when set, the artwork renders as a canvas text panel instead of an
  // image, in the chosen typeface. Null for ordinary artworks.
  text         String?
  textFont     String?
  // Colour palette extracted from the artwork image (ColorThief, in the
  // browser, at upload/replace time): a JSON array of up to 8 hex
  // colours, dominant first, e.g. ["#1A1A1A","#C8321E","#F0E6D2"].
  // Stored as a JSON string (like rooms) so it works on SQLite and
  // Postgres alike. Null until extracted.
  palette      String?
  // Alt-text for the artwork image (BLIP in the browser, or Gemini via
  // /api/describe when configured): a one-sentence description in
  // English, proposed at upload time and validated or corrected by the
  // artist before saving. Used as the <img> alt on the public artwork
  // page and for the Open Graph image. Null until generated or written.
  altText      String?
  roomId       String     @default("room-main")
  createdAt    DateTime   @default(now())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([exhibitionId])
}

// The artist's reusable artwork library ("Mes œuvres").
//
// An Artwork row belongs to exactly ONE exhibition (exhibitionId, and
// it carries that exhibition's own position / room / frame), so two
// exhibitions cannot share one Artwork row without fighting over where
// the work hangs. Reuse is therefore a COPY: a new Artwork row in the
// target exhibition with the same imageUrl — never a re-upload — and
// this table is the canonical record of the work itself, owned by the
// artist, across all exhibitions.
//
// Identity is the image URL (same R2 object = same work): one row per
// (owner, imageUrl). Rows are created lazily — on first library read
// (lib/library.ts ensureLibraryWorks, backfilling from the artworks
// already hanging in the owner's exhibitions) and on every exhibition
// save / single-artwork add — so no migration script has to run
// against production and no existing work is ever lost from the
// library. Works without an image (curatorial text panels) are not
// library works: there is nothing to re-hang elsewhere.
//
// Deleting a LibraryWork is the one explicit, confirmed delete: it
// removes the library row AND every copy hanging in the owner's
// exhibitions (same imageUrl). It has to remove the copies too —
// otherwise the next library read would backfill the row straight
// back from the copy still on the wall. The R2 file itself is never
// deleted (same policy as exhibition audio: orphaned files are a
// known cleanup debt, not a silent delete). Deleting a single copy
// from an exhibition (DELETE /api/artworks/[id]) only ever removes
// that copy: the library row and the copies in other exhibitions
// stay untouched.
model LibraryWork {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  artist      String   @default("")
  year        String   @default("")
  medium      String   @default("")
  dimensions  String   @default("")
  description String   @default("")
  // Null for video works: a video library work has no image — its
  // videoUrl below is the media. Image works keep imageUrl set.
  imageUrl    String?
  // Video artwork (Nov 2026): the same-origin serving URL of the
  // video (/api/video/videos/<userId>/<uuid>.mp4). Null for image
  // works. Identity of a library work is videoUrl ?? imageUrl (see
  // lib/library.ts): one row per (owner, media URL), image or video.
  videoUrl    String?
  // Sculpture artwork (Nov 2026): the same-origin serving URL of the
  // GLB (/api/sculpture/sculptures/<userId>/<uuid>.glb). Null for
  // image and video works. Identity of a library work is
  // sculptureUrl ?? videoUrl ?? imageUrl (see lib/library.ts): one
  // row per (owner, media URL), image, video or sculpture.
  sculptureUrl String?
  frame       String   @default("wood")
  palette     String?
  altText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, imageUrl])
  @@index([ownerId, createdAt])
}

// Uploaded artwork images, stored in the database (not on disk): Vercel's
// runtime filesystem is read-only and does not persist between requests,
// so files written to data/uploads never survived an upload there.
model Upload {
  id        String   @id
  data      Bytes
  mimeType  String   @default("image/webp")
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// One row per tool page load: which tool was opened, by whom, and when.
// No input values, form contents or calculator numbers are ever stored
// here — only the tool slug, the user id (null when not signed in) and the
// time. The table starts empty and grows from the day tracking ships.
// One row per public exhibition view (and per artwork-detail open).
// Exhibition.views stays as the blunt all-time counter; this table is
// the history behind it: per-day counts, unique visitors (via an
// anonymous random visitorKey cookie — no personal data, no IP stored),
// and, where the browser/platform supplies them, country (from the
// x-vercel-ip-country header only), device class (from the user-agent)
// and referrer. Anything absent is stored as null, never invented.
model VisitLog {
  id           String   @id @default(cuid())
  exhibitionId String
  artworkId    String?
  // The UTC-midnight date of the visit, so daily buckets are a plain
  // group-by on this column.
  day          DateTime
  visitorKey   String
  country      String?
  // IP geolocation from Vercel headers (city level, never GPS): city and
  // region as sent by x-vercel-ip-city / x-vercel-ip-country-region, plus
  // the coordinates Vercel provides (x-vercel-ip-latitude/longitude).
  // All null for visits logged before these fields shipped.
  city         String?
  region       String?
  latitude     Float?
  longitude    Float?
  device       String?
  // Operating system and browser, parsed from the user-agent (for
  // example "Windows 10/11" and "Chrome 131"). Null when unknown.
  os           String?
  browser      String?
  referrer     String?
  // Seconds the visitor spent in the exhibition, sent by the client
  // when the visit ends (pagehide). Null when the browser never
  // reported a duration — never invented.
  durationSeconds Int?
  createdAt    DateTime @default(now())

  @@index([exhibitionId, day])
  @@index([artworkId, day])
}

model ToolUse {
  id        String   @id @default(cuid())
  tool      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([tool])
  @@index([createdAt])
}

// Marketplace listings (Phase 6). A listing is public-facing: anyone can
// browse active listings; only the seller can edit or withdraw theirs.
// Payments are NOT handled here — checkout is a labelled Stripe
// integration point, not a real charge. See the Marketplace tool.
model Listing {
  id            String    @id @default(cuid())
  sellerId      String
  seller        User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  artworkId     String?
  title         String
  artist        String    @default("")
  year          String    @default("")
  medium        String    @default("")
  dimensions    String    @default("")
  description   String    @default("")
  imageUrl      String?
  price         Int?
  currency      String    @default("USD")
  kind          String    @default("original")
  editionSize   Int?
  editionNumber Int?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  inquiries     Inquiry[]

  @@index([sellerId])
  @@index([status])
}

// Purchase inquiries on a listing (Phase 6). Buyer contact details are
// stored only so the seller can reply; nothing is shared elsewhere.
model Inquiry {
  id         String   @id @default(cuid())
  // Marketplace inquiry: the listing being asked about. Null for a
  // "contact the artist" message sent from an artwork in an exhibition.
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Artist-contact inquiry: the artwork and exhibition it came from.
  artworkId    String?
  exhibitionId String?
  buyerId    String?
  buyerName  String   @default("")
  buyerEmail String   @default("")
  message    String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([exhibitionId])
  @@index([artworkId])
}

// Team collaboration (Phase 6). A team owns shared exhibition access
// (ProjectShare), comments and an activity log. Permissions are enforced
// server-side in the teams API routes, never only in the UI.
model Team {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   TeamMember[]
  shares    ProjectShare[]
  comments  TeamComment[]
  activity  TeamActivity[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model ProjectShare {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  exhibitionId String
  permission   String   @default("view")
  createdAt    DateTime @default(now())

  @@unique([teamId, exhibitionId])
  @@index([exhibitionId])
}

model TeamComment {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  exhibitionId String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  status       String   @default("open")
  createdAt    DateTime @default(now())

  @@index([teamId])
  @@index([exhibitionId])
}

model TeamActivity {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  target    String   @default("")
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// User-saved work from the Creative Studio tools (Mockup Studio, Color
// Intelligence, Photography Lab, Presentation Designer, Certificate
// Studio, Frame Studio presets). One table, `kind` distinguishes the
// tool; `data` holds the tool-specific configuration as JSON so each tool
// can evolve without a schema migration. Always user-scoped: tools only
// ever read or write the signed-in user's own rows.
model SavedWork {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String   @default("")
  data      String   @default("{}")
  artworkId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, updatedAt])
}

// Room templates hidden by the owner from the admin panel. Templates
// live in code (lib/rooms.ts); hiding one only records its layout id
// here, so the removal survives reloads and redeploys. Hidden templates
// are filtered out wherever templates are listed, but exhibitions
// already built with one keep working — they fall back to the White
// Cube only if the layout itself disappears from the code.
model HiddenRoomTemplate {
  id        String   @id @default(cuid())
  layout    String   @unique
  createdAt DateTime @default(now())
}

// Gallery names as renamed by the owner in the admin panel. Templates
// live in code (lib/rooms.ts) with English + French default names
// (lib/gallery-names.ts); a row here overrides both names for one
// layout, so a rename survives reloads and redeploys. No row means the
// code defaults apply.
model GalleryName {
  layout    String   @id
  nameEn    String
  nameFr    String
  updatedAt DateTime @updatedAt
}

// Sub-admin grants (Nov 2026): the manager (platform owner, the only
// account in ADMIN_EMAILS) can give another signed-up account limited
// access to the admin dashboard (/admin). The grant lists the permission
// keys the sub-admin holds — see ADMIN_PERMISSIONS in lib/admin.ts.
// Permissions are checked server-side on every admin page render and
// every admin API route, never only hidden in the interface. The
// manager keeps full access and is the only one who can add, change or
// remove grants (subadmins.manage is never grantable). One grant per
// user (userId unique); granting again replaces the permission list.
model SubAdmin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation("SubAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("SubAdminGrantor", fields: [grantedById], references: [id], onDelete: Cascade)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Subscriptions (Nov 2026): the three Lakisa plans from the budget and
// monetisation dossier (Lakisa_Budget_Monetisation.docx, §3.2-3.3) —
// Discovery (free), Creator (8 $/month, 80 $/year), Studio (25 $/month,
// 250 $/year). Plans are rows so the manager can rename them, change
// prices and edit the included tools from the admin dashboard; the code
// defaults in lib/subscriptions.ts seed the three rows once and never
// overwrite an admin edit. A Subscription is one row per account: every
// account starts on Discovery, the row is created lazily on first read.
// No payment is integrated in this lot: the paywall is OFF by default
// (LAKISA_PAYWALL_ENABLED, see lib/subscriptions.ts), so every tool
// stays open to everyone while the structure is in place. Billing
// (Flutterwave / Pesapal) comes later and flips the same switch.
// Applied by `prisma db push` on deploy (see vercel.json); no data
// migration — the tables start empty and are seeded on first read.
// ---------------------------------------------------------------------------
model SubscriptionPlan {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  tagline         String   @default("")
  description     String   @default("")
  monthlyPriceUsd Float    @default(0)
  yearlyPriceUsd  Float    @default(0)
  // One-month-only price (fixed one-month term, no renewal): Creator
  // $5.99, Studio $29 (Nov 2026). 0 = not offered (Discovery).
  singleMonthPriceUsd Float @default(0)
  // Feature lines shown on the pricing page, in display order.
  features        Json     @default("[]")
  // Limits, null = unlimited: exhibitions, artworks, storageGb,
  // contacts, inventory, aiActionsPerMonth (0 = not included).
  limits          Json     @default("{}")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   Subscription[]

  @@index([sortOrder])
}

model Subscription {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  // active, cancelled (kept on the plan until the period ends),
  // past_due (only once billing exists).
  status       String           @default("active")
  billingCycle String           @default("monthly")
  // trial (free trial period, no payment yet), admin (set by the
  // manager), billing (set by a real payment, later).
  source       String           @default("trial")
  startedAt    DateTime         @default(now())
  endsAt       DateTime?
  // Free months earned through referrals (Nov 2026): one month per
  // referred friend who took a paid plan, credited while the account
  // is already on a paid plan. No billing exists yet, so the credit is
  // recorded here and applied as free months when billing starts.
  freeMonths   Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([planId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Promo codes and referrals (Nov 2026)
// ---------------------------------------------------------------------------
// A promo code reduces the displayed price of a plan change (percent
// off) or grants free access for a number of days (free). The admin
// creates them in the Subscriptions section of /admin; a visitor
// applies one in the plan-change popup, and the admin can also grant a
// plan to a specific account with a code and an explicit end date.
// applicablePlanSlugs is the list of plan slugs the code works on;
// empty means every plan. maxUses null means unlimited. usedCount is
// the number of people the code brought (one use per account, enforced
// by the unique constraint on PromoCodeUse). No payment is integrated
// in this lot: a code reduces the price shown or grants free access,
// nothing is charged. Applied by `prisma db push` on deploy (see
// vercel.json); no data migration — the tables start empty.
// ---------------------------------------------------------------------------
model PromoCode {
  id                 String         @id @default(cuid())
  code               String         @unique
  // "percent" (discountValue is the percentage off) or "free" (free
  // access for accessDurationDays).
  discountType       String         @default("percent")
  discountValue      Int            @default(0)
  applicablePlanSlugs Json          @default("[]")
  maxUses            Int?
  usedCount          Int            @default(0)
  expiresAt          DateTime?
  accessDurationDays Int            @default(30)
  isActive           Boolean        @default(true)
  createdById        String
  createdBy          User           @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  uses               PromoCodeUse[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([code])
  @@index([isActive])
}

model PromoCodeUse {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSlug      String
  discountValue Int       @default(0)
  usedAt        DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@index([userId])
}

// Referral (Nov 2026): one row per invited account. status is pending
// at signup, then rewarded once the referred account takes a paid plan
// and the referrer's reward is granted (1 free month of the referrer's
// current plan, or 1 free month of Creator when the referrer is on
// Discovery). See lib/referrals.ts. Applied by `prisma db push` on
// deploy (see vercel.json); no data migration — the table starts empty.
model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String   @unique
  referredUser   User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([referrerId])
}

// ---------------------------------------------------------------------------
// Advanced website builder (Claude « atelier-sites », integrated 8 Nov 2026)
// ---------------------------------------------------------------------------
// The visual editor at /tools/website-builder/advanced. Adapted from the
// standalone builder's schema, with two SANAA changes:
//  - Site.userId is REQUIRED and the relation deletes with the user
//    (the standalone builder had an optional owner; SANAA sites always
//    belong to the signed-in user — see the API routes, which scope every
//    read/write to getCurrentUser()).
//  - No second User model: the relation above is fused onto the existing
//    SANAA User (User.sites).
// Media rows point at R2 objects (key sites/<userId>/<uuid>.<ext>),
// served same-origin by /api/site-media/[...key] — never local disk.
// Template rows are the 11 original template definitions, seeded from
// lib/advanced-site-templates.ts (scripts/seed-site-templates.mjs, and
// self-seeded by GET /api/site-templates on first call).
model Site {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  templateId String?
  design     String?
  theme      Json
  published  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages      Page[]
  media      Media[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([slug, published])
}

model Page {
  id             String    @id @default(cuid())
  slug           String
  title          String
  seoTitle       String?
  seoDescription String?
  order          Int
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sections       Section[]

  @@unique([siteId, slug])
  @@index([siteId, order])
}

model Section {
  id       String  @id @default(cuid())
  type     String
  order    Int
  settings Json
  pageId   String
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks   Block[]

  @@index([pageId, order])
}

model Block {
  id        String  @id @default(cuid())
  type      String
  content   Json
  settings  Json
  order     Int
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

model Template {
  id         String   @id
  name       String
  category   String
  definition Json
  createdAt  DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  name      String
  mimeType  String
  size      Int
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Open calls (Nov 2026): a Google Forms / Jotform-style tool in
// /tools/open-calls. The owner creates a call (title, description,
// deadline), builds its form from fields, publishes it (public link
// /open-calls/[slug]), and reads the responses. All data lives in the
// database — nothing in localStorage. File answers are stored in R2
// under open-calls/<slug>/<uuid>.<ext> (see the public upload route);
// the response row only stores the file key and name in its answers.
// ---------------------------------------------------------------------------
// status: draft (being built, no public link works yet), published
// (public link live, accepts responses until the deadline), closed
// (public link shows "closed", no more responses).
model OpenCall {
  id          String             @id @default(cuid())
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  slug        String             @unique
  description String             @default("")
  deadline    DateTime?
  status      String             @default("draft")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  fields      OpenCallField[]
  responses   OpenCallResponse[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
}

// One form field. type: short_text | long_text | email | number |
// date | select | checkbox | file. options holds the choice list for
// select/checkbox (Json string array), null otherwise.
model OpenCallField {
  id         String   @id @default(cuid())
  openCallId String
  openCall   OpenCall @relation(fields: [openCallId], references: [id], onDelete: Cascade)
  label      String
  type       String
  required   Boolean  @default(false)
  options    Json?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([openCallId, order])
}

// One submitted application. answers is a Json map fieldId -> value:
// strings for text/email/number/date, a string for select, a string
// array for checkbox, and { key, name } for a file answer (the file
// itself is in R2, served owner-only by /api/open-calls/files/...).
model OpenCallResponse {
  id         String   @id @default(cuid())
  openCallId String
  openCall   OpenCall @relation(fields: [openCallId], references: [id], onDelete: Cascade)
  answers    Json
  createdAt  DateTime @default(now())

  @@index([openCallId, createdAt])
}
